# Copy to .env for local runs (docker compose). On Render set these under Environment.
PORT=8080
DATABASE_URL=postgres://pmay:pmay@localhost:5432/pmay?sslmode=disable
JWT_SECRET=replace-with-a-random-string-of-32-or-more-characters
UPLOAD_DIR=./uploads
DEV_MODE=true          # true = OTP is returned in the API response (local only!)
CORS_ORIGINS=*

# first super admin (created on first start)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# email OTP: use ONE of these
RESEND_API_KEY=
RESEND_FROM=PMAY Registration <noreply@your-domain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS OTP
MSG91_AUTH_KEY=
MSG91_SENDER_ID=PMAYOT

# Document OCR (registration auto-fill): Google Gemini; Tesseract is the fallback if the key is empty/fails
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# push notifications (Firebase service account) - paste the JSON text, or point to a file
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_FILE=
